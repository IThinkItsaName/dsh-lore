{
  "name": "dsh-worklog",
  "version": "0.2.0",
  "description": "Long-term project work-log system for AI agents (software, research, writing, design, operations): process journal + index ledger + lessons, with a stdlib-only Python toolbox. Ships as an Agent Skill and as a DeepSeek Harness plugin bundle.",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "pi-package",
    "agent-skills",
    "work-log",
    "journal",
    "lessons",
    "documentation",
    "knowledge-base",
    "notes"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "pi": {
    "skills": [
      "./skills"
    ]
  },
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "python skills/project-work-log/scripts/_selftest.py"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "skills"
  ]
}
